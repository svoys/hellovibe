# HelloVibe — environment variables
# Copy to .env.local and fill in as needed. Never commit real secrets.

# Public site origin. Used for absolute URLs in metadata. No secret here.
NEXT_PUBLIC_SITE_URL=

# --- Reserved for later phases (not read by the foundation yet) -------------
# Address that receives contact-form submissions.
# CONTACT_EMAIL=
# Server-side only. Never prefix a secret with NEXT_PUBLIC_.
# EMAIL_API_KEY=
# Analytics provider ID.
# ANALYTICS_ID=
