# HelloVibe — environment variables
# Copy to .env.local and fill in as needed. Never commit real secrets.

# Public site origin. Used for absolute URLs in metadata. No secret here.
NEXT_PUBLIC_SITE_URL=

# --- Contact form ------------------------------------------------------------
# The form validates and rejects spam on the server today, but delivery is NOT
# connected: a valid submission says so and points at the email address instead.
# Connecting it means replacing the body of `lib/contact-delivery.ts`, which is
# the one place that will read these two. Both are server-side only — never
# prefix a secret with NEXT_PUBLIC_.
# CONTACT_EMAIL=
# EMAIL_API_KEY=

# --- Later phases ------------------------------------------------------------
# Analytics provider ID.
# ANALYTICS_ID=
